alLocations":[{"fullyQualifiedName":"'Vacations Tracking'.Button_SubmitLeave_Execute.OnSelect"}],"properties":{"module":"Vacations Tracking","type":"'Vacations Tracking'.Button_SubmitLeave_Execute","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"'Vacations Tracking'.Overlay_DeleteConfirm.DeleteConfirm_Card.delete_btn_row.btn_DeleteConfirm.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"'Vacations Tracking'.Overlay_DeleteConfirm.DeleteConfirm_Card.delete_btn_row.btn_DeleteConfirm.OnSelect"}],"properties":{"module":"Vacations Tracking","type":"'Vacations Tracking'.Overlay_DeleteConfirm.DeleteConfirm_Card.delete_btn_row.btn_DeleteConfirm","member":"OnSelect"}}],"properties":{"level":"Medium"}},{"ruleId":"app-ForAllWithMutation","ruleIndex":7,"message":{"id":"issue"},"locations":[{"physicalLocation":{"address":{"relativeAddress":0,"fullyQualifiedName":"Approvals.Button_SaveApprovals_Execute.OnSelect"}},"logicalLocations":[{"fullyQualifiedName":"Approvals.Button_SaveApprovals_Execute.OnSelect"}],"properties":{"module":"Approvals","type":"Approvals.Button_SaveApprovals_Execute","member":"OnSelect"}}],"properties":{"level":"Medium"}}],"tool":{"driver":{"name":"PowerApps app checker","fullName":"PowerApps app checker","version":"1.349","rules":[{"id":"app-SuggestRemoteExecutionHint-StringMatchSecondParam","messageStrings":{"issue":{"text":"Part of this formula cannot be evaluated remotely. The '{0}' function cannot be delegated if a field name appears in the second argument."}},"properties":{"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"app-SuggestRemoteExecutionHint","messageStrings":{"issue":{"text":"Delegation warning. The \"{0}\" part of this formula might not work correctly on large data sets."}},"properties":{"howToFix":["If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.","Try simplifying the formula.","Try moving your data to a different data source."],"whyFix":"","level":"Medium","componentType":"app","primaryCategory":"formula"}},{"id":"acc-FocusBorderShouldBeVisible","messageStrings":{"issue":{"text":"Focus isn't showing"}},"properties":{"howToFix":["Change the FocusedBorderThickness property to be more than 0."],"whyFix":"If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-TabIndexShouldBeDefinedForInteractiveControl","messageStrings":{"issue":{"text":"Missing tab stop"}},"properties":{"howToFix":["Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."],"whyFix":"People who use the keyboard with your app will not be able to access this element without a tab stop.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"acc-AccessibleLabelNeeded","messageStrings":{"issue":{"text":"Missing accessible label"}},"properties":{"howToFix":["Edit the accessible label property to describe the item."],"whyFix":"If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls.","level":"Medium","componentType":"app","primaryCategory":"accessibility"}},{"id":"app-CollectDelegatableDataSource","messageStrings":{"issue":{"text":"The rows retrieved from the data source may not be complete."}},"properties":{"howToFix":["Limit the data collected from the data source by updating the formula \"ClearCollect(colApprovalsSource, 'Vacations Tracking (Days)')\" to include a filtering function, such as 'Filter' or 'Search'."],"whyFix":"Using the 'Collect' function to create a collection directly from a connected data source may not load every row if the data source is too large.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-CollectingReadOnlyTable","messageStrings":{"issue":{"text":"Collection is initialized but never updated"}},"properties":{"howToFix":["Replace the Collect or ClearCollect with a named formula on App.Formulas. For example, MyTable = Filter(source, condition). Named formulas are computed when their inputs change and do not carry the tracking cost of a collection."],"whyFix":"Collections are meant to be updated. Power Apps does extra work to keep track of every collection so that anything depending on it stays in sync when the data changes. When the data never changes after it is set, that tracking work is wasted. A named formula gives the same data without the extra cost.","componentType":"app","primaryCategory":"performance","level":"Medium"}},{"id":"app-ForAllWithMutation","messageStrings":{"issue":{"text":"Mutating a collection or data source inside ForAll may trigger excessive rule re-evaluation"}},"properties":{"howToFix":["Since ForAll returns a table, pass its result as input to the mutation function in a single batched call. For example, replace ForAll(source, Collect(c, { ... })) with Collect(c, ForAll(source, { ... })); the same pattern applies to Patch and Remove. A single batched mutation emits one change notification instead of one per iteration.","For trivial per-row updates or deletions against a data source, prefer the delegable UpdateIf or RemoveIf functions called once outside ForAll instead of iterating with ForAll."],"whyFix":"Using Collect, Patch, Remove, or another mutation function inside the body of ForAll mutates the target collection or data source once per iteration. Every control property that depends on that collection or data source re-evaluates on each mutation, which can turn a small loop into thousands of rule evaluations and, for connected data sources, a network request per row.","componentType":"app","primaryCategory":"performance","level":"Medium"}}]}},"invocations":[{"executionSuccessful":true}],"columnKind":"utf16CodeUnits"}]}